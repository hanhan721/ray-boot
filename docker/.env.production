# ============================================================
#  中间件部署环境配置模板
#  使用方法: cp .env.production .env  然后修改所有密码和密钥
# ============================================================

# ==================== PostgreSQL ====================
PG_PORT=5432
PG_PASSWORD=<改为强密码>
PG_DATABASE=ray

# ==================== Valkey ====================
VALKEY_PORT=6379
VALKEY_PASSWORD=<改为强密码>

# ==================== RustFS ====================
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=<改为强密码>
RUSTFS_BUCKET=ray
# presigned URL 公开端点（通过前端 Nginx 反代），格式: http://your-domain:3000
RUSTFS_PUBLIC_ENDPOINT=http://your-domain:3000
