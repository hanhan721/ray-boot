# ============================================================
# PostgreSQL 数据库
# ============================================================
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ray
PG_USERNAME=postgres
PG_PASSWORD=

# ============================================================
# Redis / Valkey 缓存
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# 认证与安全
# ============================================================
# Refresh Token 签名盐（随机字符串，建议 32 位以上）
RAY_AUTH_REFRESH_SALT=

# AES-256 加密密钥（32 字节的 Base64 编码）
PARAM_ENCRYPT_KEY=

# ============================================================
# ID 生成（雪花算法）
# ============================================================
# 机器 ID（0~7），多实例部署时各实例必须不同
RAY_SNOWFLAKE_MACHINE_ID=0

# ============================================================
# 文件存储（RustFS / S3 兼容）
# ============================================================
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_PUBLIC_ENDPOINT=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=ray

# 文件公开访问基础 URL
RAY_STORAGE_PUBLIC_BASE_URL=http://localhost:9000/ray
# 文件签名密钥（用于生成带签名的私有文件访问链接）
RAY_STORAGE_SIGN_SECRET=
